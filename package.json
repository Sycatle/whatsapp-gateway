{
  "name": "whatsapp-gateway",
  "description": "WhatsApp Cloud API gateway: signed webhook receiver, sender for every message type, local conversation store and voice transcription.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
