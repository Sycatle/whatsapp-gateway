PORT=3000
META_APP_SECRET=replace-with-your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verification-token

# Optional: enables sending. All three are then required.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# For the /waba gateway (templates, subscriptions...):
# WHATSAPP_BUSINESS_ACCOUNT_ID=
API_KEY=
# GRAPH_API_VERSION=v25.0
# DOWNLOADS_DIR=downloads
# DB_PATH=data/gateway.db
# Forward processed events (content included) to your own service. Both are then required.
# EVENTS_URL=
# EVENTS_SECRET=
# Voice-note transcription (OpenAI-compatible endpoint, see README):
# TRANSCRIBE_URL=http://127.0.0.1:8178/v1/audio/transcriptions
# TRANSCRIBE_LANGUAGE=fr
# TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_API_KEY=            # only for hosted services
